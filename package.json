{
	"name": "fragments",
	"private": true,
	"version": "0.7.1",
	"description": "CCP555_Week01_Lab01 Fragments back-end API",
	"scripts": {
		"test:watch": "jest -c jest.config.js --runInBand --watch --",
		"test:integration": "hurl --test --glob \"tests/integration/**/*.hurl\"",
		"test": "jest -c jest.config.js --runInBand --",
		"coverage": "jest -c jest.config.js --runInBand --coverage",
		"lint": "eslint \"./src/**/*.js\"",
		"format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/workflows/*.yml\"",
		"format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/workflows/*.yml\"",
		"start": "node src/index.js",
		"dev": "FRAGMENTS_LOG_LEVEL=debug nodemon ./src/index.js --watch src",
		"debug": "FRAGMENTS_LOG_LEVEL=debug nodemon --inspect=0.0.0.0:9229 ./src/index.js --watch src"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikeylim/fragments.git"
	},
	"author": "Mike Dohyun Lim",
	"license": "UNLICENSED",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@orangeopensource/hurl": "^8.0.2",
		"eslint": "^10.3.0",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"nodemon": "^3.1.10",
		"prettier": "3.8.3",
		"supertest": "^7.2.2"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1102.0",
		"@aws-sdk/client-s3": "^3.1097.0",
		"@aws-sdk/lib-dynamodb": "^3.1102.0",
		"aws-jwt-verify": "^5.2.1",
		"content-type": "^2.0.0",
		"cors": "^2.8.6",
		"csv-parse": "^7.0.2",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"html-to-text": "^10.0.0",
		"http-auth": "^4.2.1",
		"http-auth-passport": "^1.0.7",
		"js-yaml": "^5.2.3",
		"markdown-it": "^14.3.0",
		"passport": "^0.7.0",
		"passport-http-bearer": "^1.0.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"sharp": "^0.35.3",
		"stoppable": "^1.1.0"
	}
}
